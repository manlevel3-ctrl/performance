name: Automated JS File Update

on:
  schedule:
    # This example runs every day at midnight (UTC). Adjust using crontab.guru
    - cron: '0 0 * * *'
  workflow_dispatch: # Allows you to manually trigger the update from the Actions tab

jobs:
  update-file:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Grants permission to push code changes back to the repository

    steps:
      # Step 1: Check out the repository data
      - name: Checkout Repository
        uses: actions/checkout@v4

      # Step 2: Set up Node.js to execute JavaScript
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      # Step 3: Run your script or modify the file
      # You can replace this with a Node script (e.g., 'node update-script.js')
      - name: Modify JS File
        run: |
          echo "// Updated on $(date)" >> your-file.js

      # Step 4: Commit and push the changes back to GitHub
      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add your-file.js
          git diff-index --quiet HEAD || git commit -m "Automated update: $(date)"
          git push
